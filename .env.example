# ExecPulse-BI Environment Configuration
# Copy this file to .env and adjust the values for local execution.

# App / Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data Source & Destination Paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
DATABASE_URL=sqlite:///data/processed/execpulse_star_schema.db
